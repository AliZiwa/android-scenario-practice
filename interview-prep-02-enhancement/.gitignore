# Android / Gradle / IDE ignore rules

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/DALVIK VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin cache
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# OS generated files
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# C/C++ build folders
.externalNativeBuild/
.cxx/

# Profiler folder
mprof/

# NDK
obj/

# Keystore files
*.jks
*.keystore
